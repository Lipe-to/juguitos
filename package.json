{
  "name": "jugitos-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "node --test worker/field.test.js && vitest run src/games/practice.test.ts src/games/rastro src/games/ovelhas src/catalog",
    "test:minas:online": "node scripts/minas-local-check.mjs",
    "test:watch": "vitest",
    "test:rules": "vitest run --no-file-parallelism src/firebase/firestore.rules.test.ts src/firebase/sheep.rules.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-juguitos",
    "minas:dev": "cd worker && cf dev",
    "minas:deploy": "cd worker && cf deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-rc.2",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
